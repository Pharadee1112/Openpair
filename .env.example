# OpenPair — API Keys
# Copy this file to .env and fill in your keys
# (Never commit .env to git!)
# You don't need all of these — one key is enough to get started.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AI...
GROQ_API_KEY=gsk_...

# Ollama (optional) — last-resort local fallback when cloud providers are rate-limited
# or no cloud key is configured at all. No API key needed, just a running server.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
